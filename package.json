{
  "name": "bank-shot",
  "version": "0.47.1",
  "private": true,
  "type": "module",
  "main": "index",
  "scripts": {
    "start": "expo start",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "web": "npm run web:setup && expo start --web",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "report": "tsx tools/report.ts",
    "design-levels": "tsx tools/design-levels.ts",
    "web:setup": "setup-skia-web public && node scripts/make-playlist.mjs",
    "build:web": "npm run web:setup && expo export --platform web",
    "serve:web": "expo serve",
    "play": "npm run build:web && node scripts/serve-web.mjs"
  },
  "dependencies": {
    "@expo-google-fonts/barlow": "^0.4.1",
    "@expo-google-fonts/barlow-condensed": "^0.4.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/slider": "5.2.1",
    "@shopify/react-native-skia": "2.14.0",
    "expo": "^58.0.17",
    "expo-asset": "~58.0.18",
    "expo-audio": "~58.0.10",
    "expo-constants": "~58.0.13",
    "expo-font": "~58.0.9",
    "expo-haptics": "~58.0.7",
    "expo-linking": "~58.0.14",
    "expo-router": "~58.0.25",
    "expo-splash-screen": "~58.0.11",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/react": "^19.3.0",
    "esbuild": "^0.24.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
