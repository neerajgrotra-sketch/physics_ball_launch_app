{
  "expo": {
    "name": "Bank Shot",
    "slug": "bank-shot",
    "version": "0.5.0",
    "scheme": "bankshot",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "buildNumber": "1"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-font",
      "expo-audio",
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 150,
          "resizeMode": "contain",
          "backgroundColor": "#dfe5d8",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#0f2b52"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "name": "Bank Shot",
      "backgroundColor": "#dfe5d8"
    },
    "icon": "./assets/icon.png",
    "backgroundColor": "#dfe5d8",
    "android": {
      "versionCode": 1
    }
  }
}
