{
  "expo": {
    "name": "Bank Shot",
    "slug": "bank-shot",
    "version": "0.1.0",
    "scheme": "bankshot",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-font",
      "expo-audio",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "name": "Bank Shot",
      "backgroundColor": "#dfe5d8"
    },
    "icon": "./assets/icon.png",
    "backgroundColor": "#dfe5d8"
  }
}
